# ==============================================================================
# AI-Powered Packaged Product Compliance Verification System
# Environment Configuration
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
DEBUG=false
APP_NAME=packaged-product-compliance-backend
APP_TITLE="AI-Powered Packaged Product Compliance Verification System API"
APP_VERSION=1.0.0

# Network & Server Binding
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api

# Database Configuration (PostgreSQL in production, SQLite in local tests)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/compliance_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=1800

# CORS Allowed Origins (Comma-separated list or JSON array)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Security & Upload Constraints
MAX_UPLOAD_SIZE_BYTES=20971520

# AI Explanation & LLM Configuration (mock | gemini | openai)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT=10.0
LLM_TEMPERATURE=0.1

# Frontend Configuration (Used by Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000
